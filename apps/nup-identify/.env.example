# NuP-Identify Standalone Deployment

# Database
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require&options=--search_path%3Dnup_identify%2Cpublic

# Server
NODE_ENV=production
PORT=5002
BASE_PREFIX=/nup-identify

# Authentication & Session
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOM_BYTES
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOM_BYTES

# Replit OAuth
REPLIT_CLIENT_ID=your_client_id
REPLIT_CLIENT_SECRET=your_client_secret

# Optional: Session configuration
# SESSION_MAX_AGE=86400000
# SESSION_SECURE=true
