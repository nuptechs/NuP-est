# Custom Fields Service Configuration

# Server
PORT=3002
NODE_ENV=development

# CORS - Add all NuP apps that will consume this service
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5001,http://localhost:5002,http://localhost:5003,http://localhost:5173

# Database (SQLite - auto-created in data/)
# No configuration needed - uses local SQLite database

# Rate Limiting (optional)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
