{
  "name": "@nup/email",
  "version": "1.0.0",
  "description": "Shared email infrastructure for NuP ecosystem",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "email",
    "sendgrid",
    "transactional-email",
    "nup"
  ],
  "author": "NuP Team",
  "license": "MIT",
  "peerDependencies": {
    "@sendgrid/mail": "^8.1.4"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
