{
  "name": "@nup/mindmaps",
  "version": "1.0.0",
  "description": "Sistema completo de Mind Maps com AI, SimpleMind features, e RAG integration",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit"
  },
  "keywords": ["mindmap", "ai", "visualization", "study", "nup"],
  "author": "NuP Team",
  "license": "MIT",
  "dependencies": {
    "@nup/ui": "workspace:*",
    "@nup/api-client": "workspace:*",
    "@nup/shared-types": "workspace:*",
    "dagre": "^0.8.5",
    "elkjs": "^0.9.3",
    "zustand": "^5.0.8",
    "html-to-image": "^1.11.11",
    "jspdf": "^2.5.2"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@xyflow/react": "^12.9.2",
    "@tanstack/react-query": "^5.62.11",
    "lucide-react": "^0.462.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/dagre": "^0.7.52",
    "typescript": "^5.6.3"
  }
}
