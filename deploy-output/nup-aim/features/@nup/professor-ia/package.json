{
  "name": "@nup/professor-ia",
  "version": "1.0.0",
  "description": "Professor IA - Sistema de voz em tempo real com OpenAI Realtime API para tutoria adaptativa",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit"
  },
  "keywords": ["voice", "ai", "tutor", "realtime", "openai", "nup"],
  "author": "NuP Team",
  "license": "MIT",
  "dependencies": {
    "@nup/ui": "workspace:*",
    "@nup/api-client": "workspace:*",
    "@nup/shared-types": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@tanstack/react-query": "^5.62.11",
    "lucide-react": "^0.462.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
